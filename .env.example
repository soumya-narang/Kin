# --- Server ---
PORT=3000
# Household this deployment serves (one parent per household in the demo)
KIN_HOUSEHOLD_ID=demo
# Optional bearer token required on /mcp (set this when the server is public)
KIN_MCP_TOKEN=
# Set to "true" on a public deployment: the demo reset endpoint wipes the care record
KIN_DISABLE_DEMO_RESET=
# Time zone of the person being cared for (IANA name). Medication times and
# "no check-in today" are evaluated in this zone; hosted containers default to UTC.
# TZ=Asia/Kolkata

# --- Agent ---
# "bedrock"   Amazon Bedrock via the Converse API (needs Bedrock model access).
# "openai"    Any OpenAI-compatible API with tool calling. Free options:
#               Groq   KIN_OPENAI_BASE_URL=https://api.groq.com/openai/v1  KIN_OPENAI_MODEL=llama-3.3-70b-versatile
#               Gemini KIN_OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai  KIN_OPENAI_MODEL=gemini-2.5-flash
# "anthropic" Claude API directly. Set ANTHROPIC_API_KEY below.
# "mock"      rule-based agent with no cloud calls (UI work without credentials).
KIN_LLM=bedrock
# KIN_OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
KIN_ANTHROPIC_MODEL=claude-sonnet-5-5
AWS_REGION=us-east-1
# Any Bedrock model that supports tool use through the Converse API
KIN_MODEL_ID=us.amazon.nova-pro-v1:0
# Where the agent connects to the MCP server (defaults to this server's /mcp)
KIN_MCP_URL=

# --- Storage ---
# Set to a DynamoDB table name (partition key "pk", sort key "sk", both strings)
# to persist in DynamoDB. Leave empty to use a local JSON file in ./data.
KIN_TABLE=

# --- Family notifications ---
# SNS topic the family subscribes to (email/SMS). Leave empty to only record
# alerts on the family dashboard.
KIN_SNS_TOPIC_ARN=

# AWS credentials are read from the standard chain (env vars, ~/.aws, SSO, IAM role)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
